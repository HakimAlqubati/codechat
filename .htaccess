Options -Indexes
RewriteEngine on
IndexIgnore *

<FilesMatch "^\.(env|git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RewriteRule ^room([0-9]+)$ index.php?room=$1 [QSA]
